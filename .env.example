# PostgreSQL connection string (Railway provides this via the Postgres service)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Long random secret. Also signs the admin session cookie.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Public URL of the site, e.g. https://borolaunchpad.com
NEXTAUTH_URL=https://your-domain.example

# Password for the /admin panel. Anyone with this can read every booking,
# registration and contact message — make it long and unique.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional: dedicated secret for the admin session signature.
# Falls back to NEXTAUTH_SECRET when unset.
# ADMIN_SESSION_SECRET=
